LOGMONITOR_VERSION=1.1.5
# Default compose connects to an existing MySQL 8.0.36+ server with V14 schema.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=logm
DB_USERNAME=logmonitor
DB_PASSWORD=replace-with-secret
# Only used by optional compose.mysql.yaml. Generate a distinct password.
MYSQL_ROOT_PASSWORD=replace-with-root-secret
LOG_MONITOR_ADMIN_USERNAME=admin
LOG_MONITOR_ADMIN_PASSWORD=replace-with-strong-password
# openssl rand -base64 32
LLM_CONFIG_MASTER_KEY=replace-with-base64-32-byte-key
SESSION_COOKIE_SECURE=true
LISTEN_ADDRESS=127.0.0.1
FRONTEND_PORT=8081
CENTER_LOG_DIR=./logs
AGENT_LOG_DIR=./logs
AGENT_CONFIG_DIR=./agent-config
AGENT_UPLOAD_WORKERS=2
