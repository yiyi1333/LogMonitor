# Backend
SPRING_PROFILES_ACTIVE=prod
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=logmonitor
DB_USERNAME=logmonitor
DB_PASSWORD=replace-with-secret
LOG_MONITOR_ADMIN_USERNAME=admin
LOG_MONITOR_ADMIN_PASSWORD=replace-with-strong-password
LOG_ROOT=/var/log/your-application
LOG_SOURCE_ALLOWED_ROOTS=/var/log/your-application
LOG_SCAN_INTERVAL_MS=30000
SESSION_COOKIE_SECURE=true

# Required for encrypting provider API keys. Generate with: openssl rand -base64 32
LLM_CONFIG_MASTER_KEY=replace-with-base64-32-byte-key
LLM_ALLOW_HTTP=false
LLM_TIMEOUT_SECONDS=120
LLM_TEST_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2048

# Optional local image-generation tooling (never commit the real key)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-api-key
